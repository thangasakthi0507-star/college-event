    border:1px solid rgba(255,255,255,.1);
    border-radius:15px;
    overflow:hidden;
    transition:.4s;
}

.card::before{
    content:"";
    position:absolute;
    width:150px;
    height:150px;
    background:#00f7ff;
    filter:blur(80px);
    opacity:.12;
    right:-60px;
    top:-60px;
}

.card:hover{
    transform:translateY(-10px);
    border-color:#00f7ff;
    box-shadow:0 20px 50px rgba(0,247,255,.12);
}

.icon{
    font-size:40px;
    margin-bottom:20px;
}

.card h3{
