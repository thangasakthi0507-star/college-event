<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Poppins,sans-serif;
    background:#050505;
    color:white;
    overflow-x:hidden;
}

/* ================= LOADER ================= */

#loader{
    position:fixed;
    inset:0;
    background:#020202;
    z-index:9999;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
}

.loader-logo{
    font-family:Orbitron;
    font-size:42px;
    letter-spacing:8px;
    animation:pulse 1.5s infinite;
}

.loader-line{
    width:180px;
    height:3px;
    background:linear-gradient(90deg,transparent,#00f7ff,transparent);
    margin-top:20px;
    animation:load 1.5s infinite;
}

@keyframes pulse{
    50%{opacity:.4;transform:scale(1.05);}
}

@keyframes load{
    from{transform:translateX(-100%);}
    to{transform:translateX(100%);}
}

/* ================= BACKGROUND ================= */

canvas{
    position:fixed;
    inset:0;
    z-index:-2;
}

.overlay{
    position:fixed;
    inset:0;
    background:
    radial-gradient(circle at 20% 30%,rgba(0,247,255,.08),transparent 30%),
    radial-gradient(circle at 80% 70%,rgba(120,0,255,.1),transparent 30%);
    z-index:-1;
}

/* ================= NAVBAR ================= */

nav{
    position:fixed;
    top:0;
    width:100%;
    padding:20px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:1000;
    background:rgba(0,0,0,.35);
    backdrop-filter:blur(15px);
    border-bottom:1px solid rgba(255,255,255,.08);
}

.logo{
    font-family:Orbitron;
    font-size:24px;
    font-weight:800;
    letter-spacing:3px;
    color:#00f7ff;
}

nav ul{
    display:flex;
    gap:30px;
    list-style:none;
}

nav a{
    color:white;
    text-decoration:none;
    font-size:14px;
    transition:.3s;
}

nav a:hover{
    color:#00f7ff;
    text-shadow:0 0 15px #00f7ff;
}

/* ================= HERO ================= */

.hero{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:100px 20px 50px;
}

.hero-content{
    max-width:1000px;
}

.badge{
    display:inline-block;
    padding:8px 20px;
    border:1px solid #00f7ff;
    border-radius:50px;
    color:#00f7ff;
    font-size:13px;
    letter-spacing:2px;
    margin-bottom:25px;
    box-shadow:0 0 20px rgba(0,247,255,.2);
}

.hero h1{
    font-family:Orbitron;
    font-size:clamp(55px,10vw,125px);
    line-height:.9;
    letter-spacing:5px;
    background:linear-gradient(90deg,#fff,#00f7ff,#a855f7,#fff);
    background-size:300%;
    -webkit-background-clip:text;
    color:transparent;
    animation:gradient 5s infinite;
}

@keyframes gradient{
    0%,100%{background-position:0%;}
    50%{background-position:100%;}
}

.hero h2{
    margin:30px 0 10px;
    font-size:22px;
    font-weight:400;
    letter-spacing:4px;
}

.hero p{
    color:#aaa;
    max-width:650px;
    margin:auto;
}

.buttons{
    margin-top:35px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:15px 30px;
    border-radius:6px;
    text-decoration:none;
    font-weight:600;
    transition:.3s;
}

.primary{
    background:#00f7ff;
    color:#000;
    box-shadow:0 0 25px rgba(0,247,255,.35);
}

.primary:hover{
    transform:translateY(-5px);
    box-shadow:0 0 40px #00f7ff;
}

.secondary{
    border:1px solid #555;
    color:white;
}

.secondary:hover{
    border-color:#00f7ff;
    color:#00f7ff;
}

/* ================= COUNTDOWN ================= */

.countdown{
    display:flex;
    justify-content:center;
    gap:15px;
    margin-top:50px;
    flex-wrap:wrap;
}

.time-box{
    width:90px;
    padding:15px 5px;
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.1);
    border-radius:10px;
    backdrop-filter:blur(10px);
}

.time-box span{
    display:block;
    font-family:Orbitron;
    font-size:28px;
    color:#00f7ff;
}

.time-box small{
    color:#777;
}

/* ================= SECTIONS ================= */

section{
    padding:100px 7%;
}

.section-title{
    text-align:center;
    margin-bottom:60px;
}

.section-title span{
    color:#00f7ff;
    font-size:13px;
    letter-spacing:4px;
}

.section-title h2{
    font-family:Orbitron;
    font-size:40px;
    margin-top:10px;
}

/* ================= EVENT CARDS ================= */

.event-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:25px;
}

.card{
    position:relative;
    padding:30px;
    min-height:220px;
    background:linear-gradient(
        145deg,
        rgba(255,255,255,.08),
        rgba(255,255,255,.02)
